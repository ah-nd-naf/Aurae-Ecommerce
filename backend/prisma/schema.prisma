
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String
  isVerified    Boolean  @default(false)
  otp           String?  // To store the 6-digit code 
  otpExpiresAt  DateTime?
  createdAt     DateTime @default(now())
}
